{
  "name": "startup-ayush-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Startup-AYUSH desktop demonstration",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/services/*.test.js",
    "format": "prettier --write \"**/*.{js,jsx,json,css,html,md}\"",
    "dist": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "org.startupayush.desktop",
    "productName": "Startup-AYUSH Desktop",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "prettier": "^3.10.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
